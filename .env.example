# Academic Pathways Advisor — copy to .env.local (gitignored). Everything
# NEXT_PUBLIC_* is optional against hosted iblai.app; defaults live in
# lib/iblai/config.ts. The server holds no secret: it acts with the signed-in
# user's session, and agent setup mints the tools' key on the platform.

# The community organization — where a user lands when nothing else resolves.
NEXT_PUBLIC_MAIN_TENANT_KEY=main

# The public origin of THIS deployment. The platform's agent runtime calls the
# tool server back on it, so the agent only gets live tools when this is https.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pin the advisor agent instead of reading it from the organization's metadata.
# NEXT_PUBLIC_DEFAULT_AGENT_ID=

# Which data/catalog/<id>.json the app advises from.
# ADVISOR_CATALOG=citytech

# Self-hosted platform:
# NEXT_PUBLIC_API_BASE_URL=https://api.iblai.app
# NEXT_PUBLIC_AUTH_URL=https://login.iblai.app
# NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=iblai.app
# NEXT_PUBLIC_OS_URL=https://os.ibl.ai
